# ---- 存储 ----
# 留空则使用 var/stockpact.db（SQLite，WAL）
STOCKPACT_DATABASE_URL=
STOCKPACT_DATA_DIR=

# ---- 履约参数 ----
STOCKPACT_RESERVATION_TTL=90
STOCKPACT_ORDER_DEADLINE=600
STOCKPACT_PAYMENT_MAX_ATTEMPTS=3
STOCKPACT_PAYMENT_BACKOFF=0.4

# ---- 后台循环 ----
STOCKPACT_BACKGROUND=1
STOCKPACT_OUTBOX_INTERVAL=0.3
STOCKPACT_OUTBOX_BATCH=50
STOCKPACT_OUTBOX_MAX_ATTEMPTS=5
STOCKPACT_RECOVERY_INTERVAL=1.0

# ---- 保护 ----
# 设置后，管理端接口（建档/补货/混沌/恢复）必须携带 X-API-Key
STOCKPACT_API_KEY=
STOCKPACT_RATE_LIMIT=1
STOCKPACT_RATE_LIMIT_RPS=60
STOCKPACT_RATE_LIMIT_BURST=120

# ---- 其他 ----
STOCKPACT_CACHE_TTL=2.0
STOCKPACT_SAGA_LEASE=5.0
STOCKPACT_LOG_LEVEL=INFO
